# ─────────────────────────────────────────────────────────────
# TitanHTTP — .editorconfig  (Phase 1 / Task 1.1 / Subtask 5)
# ─────────────────────────────────────────────────────────────
# https://editorconfig.org
# Supported by VS Code, GoLand, Vim, NeoVim, Sublime, and most
# modern editors. Ensures consistent style across contributors.

# Top-of-file marker — stop searching parent directories.
root = true

# ── Default (all files) ─────────────────────────────────────
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# ── Go source ───────────────────────────────────────────────
[*.go]
indent_style = tab
indent_size = 4

# ── Markdown / documentation ───────────────────────────────
[*.md]
trim_trailing_whitespace = false

# ── YAML / TOML / config ────────────────────────────────────
[*.{yml,yaml,toml}]
indent_size = 2

# ── Shell scripts ──────────────────────────────────────────
[*.sh]
indent_style = space
indent_size = 2

# ── Editor project files ───────────────────────────────────
[*.json]
indent_size = 2
